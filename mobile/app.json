{
  "expo": {
    "name": "Gridline",
    "slug": "gridline",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gridline-icon.png",
    "scheme": "gridline",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.gridline.mobile",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f766e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.gridline.mobile"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0f766e",
          "image": "./assets/images/gridline-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
